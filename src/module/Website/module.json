{
  "name": "Website",
  "version": "1.0.0",
  "language": "c",
  "description": "HTTP and web interaction module",
  "main": "Website.c",
  "headers": ["Website.h"],
  "exports": [
    {"name": "ko_http_get", "type": "string", "args": [{"name": "url", "type": "string"}, {"name": "timeout", "type": "int"}]},
    {"name": "ko_http_post", "type": "string", "args": [{"name": "url", "type": "string"}, {"name": "body", "type": "string"}, {"name": "timeout", "type": "int"}]},
    {"name": "ko_http_request", "type": "string", "args": [{"name": "req", "type": "string"}, {"name": "timeout", "type": "int"}]},
    {"name": "ko_http_response_free", "type": "string", "args": [{"name": "res", "type": "string"}]},
    {"name": "ko_url_encode", "type": "string", "args": [{"name": "str", "type": "string"}]},
    {"name": "ko_url_decode", "type": "string", "args": [{"name": "str", "type": "string"}]}
  ],
  "builtin": true,
  "compiler": "main.zig"
}