{
  "name": "Os",
  "version": "1.0.0",
  "language": "c",
  "description": "Operating system interaction module",
  "main": "Os.c",
  "headers": ["Os.h"],
  "exports": [
    {"name": "get_env", "type": "string", "args": [{"name": "name", "type": "string"}]},
    {"name": "set_env", "type": "void", "args": [{"name": "name", "type": "string"}, {"name": "value", "type": "string"}]},
    {"name": "file_exists", "type": "bool", "args": [{"name": "path", "type": "string"}]},
    {"name": "file_size", "type": "int", "args": [{"name": "path", "type": "string"}]},
    {"name": "get_cwd", "type": "string", "returns": "string"},
    {"name": "set_cwd", "type": "void", "args": [{"name": "path", "type": "string"}]},
    {"name": "exec", "type": "string", "args": [{"name": "cmd", "type": "string"}]},
    {"name": "exit", "type": "void", "args": [{"name": "code", "type": "int"}]}
  ],
  "builtin": true,
  "compiler": "main.zig"
}