{
  "name": "compiler_ko",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    }
  },
  "onCreateCommand": "bash .devcontainer/on-create.sh",
  "updateContentCommand": "bash .devcontainer/on-create.sh",
  "remoteEnv": {
    "KO_PYTHON": "${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "zig.zig",
        "ms-vscode.cpptools",
        "vscjava.vscode-java-pack",
        "ms-dotnettools.csharp",
        "ms-python.python",
        "oven.bun-vscode",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "zig.path": "/usr/local/bin/zig",
        "files.exclude": {
          "**/zig-out": true,
          "**/.zig-cache": true,
          "**/.zig-global-cache": true,
          "**/.kilo/worktrees": true
        },
        "C_Cpp.default.compilerPath": "/usr/bin/gcc-13",
        "java.configuration.updateBuildConfiguration": "automatic"
      }
    }
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "module-store-api",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "bash .devcontainer/on-create.sh",
  "remoteUser": "codespace"
}
