[
    int(10)~x
    int(20)~y
    int(x + y)~sum

    <printf>^("Sum: {sum}\n")

    <if>(sum > 25) [
        <printf>^("Sum is greater than 25\n")
    ]

    string("Hello")~s
    int(<len>^(s))~len_s
    <printf>^("Length: {len_s}\n")

    byte(65)~b
    <printf>^("Byte: {b}\n")

    bytes(16)~buf
    int(<len>^(buf))~buf_len
    <printf>^("Buffer length: {buf_len}\n")

    booling(\True\)~flag
    <if>(flag) [
        <printf>^("Flag is true\n")
    ]

    <catch>(`TestError`) [
        <printf>^("Caught error\n")
    ]
]
